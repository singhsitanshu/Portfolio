      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "TaskForge: Fault-Tolerant Task Processing | Go, PostgreSQL, Redis, Docker, Prometheus",
      "protectedControls": []
    },
    {
      "paragraphId": "P00038",
      "path": "tabs.t.nddzyfo93agp.body.content[38]",
