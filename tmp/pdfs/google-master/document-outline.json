      "isListItem": true,
      "listId": "kix.3egcl3kx3uya",
      "nestingLevel": null,
      "table": null,
      "text": "Tested task-state integrity and crash recovery across 3,000 tasks / 6,000 ordered attempts with zero duplicates; recovered 30 hard-killed attempts with zero duplicate effects.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00040",
