      "startIndex": 2621,
      "endIndex": 2822,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": true,
      "listId": "kix.3egcl3kx3uya",
      "nestingLevel": null,
      "table": null,
      "text": "Built Go/PostgreSQL backend services for task processing with atomic SQL claims, heartbeats, renewable leases, retries, and idempotent submission; instrumented reliability with Prometheus and Grafana.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00039",
      "path": "tabs.t.nddzyfo93agp.body.content[39]",
